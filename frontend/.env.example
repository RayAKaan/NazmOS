NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side backend URL used by the Next.js BFF rewrite (/api/v1 -> backend).
# Required at build time in production (the value is baked into the build).
API_URL=http://localhost:8000

# Nazm Agent OS – v1.5
NEXT_PUBLIC_AGENT_ENABLED=true
NEXT_PUBLIC_VERTICAL_PHARMACY=true
NEXT_PUBLIC_VERTICAL_FOOD=false
NEXT_PUBLIC_VERTICAL_AUTO_PARTS=false

# Legacy – Baseer Chat – OFF
NEXT_PUBLIC_CHAT_ENABLED=false

# Client-side CSV ETL (PapaParse) — zero-cost mode
NEXT_PUBLIC_CLIENT_ETL=false

# Localization
NEXT_PUBLIC_APP_NAME=NazmOS KSA
NEXT_PUBLIC_CURRENCY=SAR
NEXT_PUBLIC_LOCALE=ar-SA

# Error tracking — https://sentry.io. Optional in dev, recommended in production.
NEXT_PUBLIC_SENTRY_DSN=
