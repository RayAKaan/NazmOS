# NazmOS local environment example

# Core business-reality ingestion does not require an LLM.
# Intelligence and Loop configure their LLM gateway separately.

JEV_ENABLED=false
JEV_SHADOW_ENABLED=false
JEV_BASE_URL=https://system-one.dev/v1/systemone
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_SECONDS=20

ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx,.xls,.json,.pdf,.docx,.txt
