# NazmOS backend environment — development
DATABASE_URL=postgresql+asyncpg://nazmos:nazmos_dev@localhost:5432/nazmos
# For local SQLite: DATABASE_URL=sqlite+aiosqlite:///./nazmos.db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=dev-secret-key-change-in-production-minimum-32-chars
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=uploads

# Error tracking — https://sentry.io. Required in production: the app fails
# closed (startup warning) if SENTRY_DSN is missing there.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# PostgreSQL Row-Level Security app role. Required in production so the app
# connection issues SET ROLE after setting app.current_tenant_id and RLS
# policies are enforced even though the migration user is the table owner.
# Create with the alembic migration 33dd43e565ed, then set here.
DATABASE_APP_ROLE=nazmos_app

# POS credential vault master key. Required in production (per-install key, no
# dev fallback). Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
CREDENTIAL_MASTER_KEY=

# When set, /metrics requires the X-Metrics-Token header to match.
METRICS_TOKEN=

# Zero-Cost Architecture — set to false for $0 deployments
USE_CELERY=false
USE_REDIS=false
USE_CLIENT_ETL=false

# OpenRouter model router — free tier default
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=NazmOS by Nazmak
LLM_MODEL=google/gemma-2-9b-it:free
USE_MOCK_LLM=true
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000

CHAT_ENABLED=true
BILLING_ENABLED=true
AGENT_ENABLED=true
