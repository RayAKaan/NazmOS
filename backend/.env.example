# NazmOS backend environment — development
DATABASE_URL=postgresql+asyncpg://nazmos:nazmos_dev@localhost:5432/nazmos
# For local SQLite: DATABASE_URL=sqlite+aiosqlite:///./nazmos.db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=dev-secret-key-change-in-production-minimum-32-chars
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=uploads

# Error tracking — https://sentry.io. Required in production: the app fails
# closed (startup warning) if SENTRY_DSN is missing there.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# PostgreSQL Row-Level Security app role. Required in production so the app
# connection issues SET ROLE after setting app.current_tenant_id and RLS
# policies are enforced even though the migration user is the table owner.
# Create with the alembic migration 33dd43e565ed, then set here.
DATABASE_APP_ROLE=nazmos_app

# POS credential vault master key. Required in production (per-install key, no
# dev fallback). Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
CREDENTIAL_MASTER_KEY=

# When set, /metrics requires the X-Metrics-Token header to match.
METRICS_TOKEN=

# Zero-Cost Architecture — set to false for $0 deployments
USE_CELERY=false
USE_REDIS=false
USE_CLIENT_ETL=false

# LLM providers — direct Groq + Google Gemini (no gateway). At least one key
# is required in production; USE_MOCK_LLM=true or missing keys fall back to
# rule-based mock responses in development only.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_AI_API_KEY=your-google-ai-studio-key
GOOGLE_AI_MODEL=gemini-2.5-flash-lite
LLM_PROVIDER_ORDER=groq,google,mock
USE_MOCK_LLM=true
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000

# WhatsApp Business Cloud API — mock ($0 deep-link fallback) or live
# (requires WHATSAPP_TOKEN + WHATSAPP_PHONE_ID).
WHATSAPP_ENABLED=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

CHAT_ENABLED=true
BILLING_ENABLED=true
AGENT_ENABLED=true
