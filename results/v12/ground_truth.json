    "schema": {
      "case": {
        "sku": "string, must match generated CSV item_sku",
        "category": "GT category tag (not the DB category): FAST|DEAD|SLOW|SEASONAL|STOCKOUT|PO|OVERSTOCK|GROWTH|MARGIN|OWNER_CONSTRAINT",
        "scenario": "human description of designed inputs",
        "inputs": {
          "current_stock": "inventory units at audit time",
          "qty_30d": "units sold in last 30 days (drives daily=qty_30d/30)",
          "qty_prior_30d": "units sold in prior 30 days",
          "days_since_last_sale": "days since last sale (None if never sold)",
          "monthly_concentrations": "list of per-month qty in last 90d for seasonal detection (>=2 entries)",
          "cost_price": "SAR",
          "sell_price": "SAR",
          "confirmed_inbound_qty": "units on confirmed purchase order",
          "lead_time_days": "supplier lead time"
        },
        "expected_classification": "per classify_inventory: NEW|SEASONAL|DEAD|UNKNOWN|SLOW MOVING|FAST|HEALTHY",
        "expected_monetary_classification": "the intended product category driving capital-at-risk vs healthy (FAST/DEAD/SLOW/SEASONAL/OVERSTOCK/GROWTH)",
        "expected_decision": "per deterministic_decision_for_item: DO_NOTHING|REORDER|DISCOUNT|TRANSFER|RECOVERY_MATCH|MANUAL_REVIEW",
        "expected_primary_action": "the money-audit action_type expected for this SKU (discount|reorder|transfer|none)",
        "financial_expectation": "semantic expectation for the SKU's financial impact (CAPITAL_AT_RISK | REVENUE_AT_RISK | PROFIT_OPPORTUNITY | NONE) -- must NEVER be reported as recovered cash",
        "expected_recovery_semantics": "expected_recovery must be null (no calibration) and recoverable_high bounded by min(cost basis, gross proceeds); the range is NOT recovered cash"
      }
    },
    "checksum_algorithm": "sha256 over json.dumps({schema: meta.schema, cases: cases}, sort_keys=True)"
  },
