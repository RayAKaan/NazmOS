# NazmOS production .env example
# Copy to .env on the VPS (deploy.yml writes it from GitHub Secrets, fail-closed).
# All values marked :? in docker-compose.prod.yml are REQUIRED — a missing value
# aborts the deployment instead of degrading it silently.

# Images published by .github/workflows/deploy.yml (build-image job + per-env frontend).
API_IMAGE=ghcr.io/YOUR_ORG/nazmos-api:latest
OPENCODE_RUNNER_IMAGE=ghcr.io/YOUR_ORG/nazmos-opencode-runner:latest
FRONTEND_IMAGE=ghcr.io/YOUR_ORG/nazmos-frontend:staging-<sha>

# Infrastructure
DB_PASSWORD=
REDIS_PASSWORD=
SECRET_KEY=
CREDENTIAL_MASTER_KEY=
DATABASE_APP_ROLE=nazmos_app
METRICS_TOKEN=

# Public surfaces
CORS_ORIGINS=https://app.nazm.ai
PUBLIC_API_URL=https://app.nazm.ai
SENTRY_DSN=

# App behavior
USE_MOCK_LLM=false
LLM_PROVIDER_ORDER=groq,google,mock
GROQ_API_KEY=
GOOGLE_AI_API_KEY=
API_WORKERS=2
BACKUP_RETENTION_DAYS=7

# OpenCode runner provider keys (routed to LLM providers by the runner bridge).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NAZMOS_OPENCODE_MODEL=
NAZMOS_CAPSULE_SIGNING_KEY=

# WhatsApp
WHATSAPP_ENABLED=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=