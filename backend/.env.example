# NazmOS backend environment — development
DATABASE_URL=postgresql+asyncpg://nazmos:nazmos_dev@localhost:5432/nazmos
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=dev-secret-key-change-in-production-minimum-32-chars
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=uploads

# Phase 1 Orbit — no LLM key is required.
JEV_ENABLED=false
JEV_SHADOW_ENABLED=false
JEV_BASE_URL=https://system-one.dev/v1/systemone
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_SECONDS=20
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx,.xls,.json,.pdf,.docx,.txt

SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

DATABASE_APP_ROLE=nazmos_app
CREDENTIAL_MASTER_KEY=
METRICS_TOKEN=

USE_TEMPORAL=true
USE_REDIS=false
USE_CLIENT_ETL=false

# Intelligence / Loop LLM configuration is optional for this Orbit-only phase.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash-lite
LLM_PROVIDER_ORDER=groq,google
USE_MOCK_LLM=false
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000

WHATSAPP_ENABLED=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
CHAT_ENABLED=true
BILLING_ENABLED=true
AGENT_ENABLED=true
